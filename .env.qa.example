# Disposable QA environment only. Copy to .env.qa and replace every placeholder.
# Generate database/root/JWT values with a private random-secret generator.
QA_DATABASE_NAME=nexus_qa_test
QA_DATABASE_USER=nexus_qa_runner
QA_DATABASE_PASSWORD=replace-with-64-hex-characters
QA_MYSQL_ROOT_PASSWORD=replace-with-64-hex-characters
QA_JWT_SECRET_KEY=replace-with-output-of-openssl-rand-hex-32

# Bootstrap this account using the same password set in QA_ADMIN_PASSWORD.
QA_ADMIN_EMAIL=qa-admin@example.com
QA_ADMIN_NAME=QA Administrator
QA_ADMIN_PASSWORD=replace-with-64-hex-characters

# Password assigned to secondary users created by RBAC API tests.
QA_RBAC_PASSWORD=replace-with-a-different-64-hex-password
