APP_ENV=development
HTTP_PORT=8080
JWT_SECRET_KEY=replace_with_output_of_openssl_rand_hex_32
MYSQL_DATABASE=nexus_crm
MYSQL_USER=nexus
MYSQL_PASSWORD=change_me_for_local_dev
MYSQL_ROOT_PASSWORD=change_root_password
MYSQL_PORT=3307
SMTP_HOST=mailhog
SMTP_PORT=1025
SMTP_FROM=nexus@localhost
APP_LOGIN_URL=http://localhost:8080/login
TEMPORARY_PASSWORD_HOURS=24
EXPOSE_TEMPORARY_PASSWORDS=false
MAILHOG_UI_PORT=8025
CORS_ORIGINS=http://localhost:8080
# Use a fine-grained token with read-only Pull requests access for the allowlisted repositories.
GITHUB_TOKEN=
# Generate an independent random secret and set the same value in the GitHub webhook configuration.
GITHUB_WEBHOOK_SECRET=
GITHUB_ALLOWED_REPOSITORIES=owner/repository
GITHUB_INGESTION_TIMEOUT_SECONDS=60
GITHUB_API_REQUEST_TIMEOUT_SECONDS=8
GITHUB_API_MAX_RETRIES=2
GITHUB_API_MAX_RESPONSE_BYTES=2000000
